+          sendTimeout: const Duration(seconds: 15),
+          receiveTimeout: const Duration(seconds: 35),
+        ),
+      );
+    } catch (error) {
+      // Firestore message/request was already committed. The cron fallback
+      // picks up its pending notification if Render is sleeping or offline.
+      debugPrint('Chat notification dispatch queued for retry: $error');
+    }
