import 'dart:async';

import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:dio/dio.dart';
import 'package:firebase_auth/firebase_auth.dart';
import 'package:flutter/material.dart';

import '../config/app_config.dart';
import '../theme/app_theme.dart';
import '../widgets/app_usage_icon.dart';

/// Dedicated paired parent-child chat, independent of Reports and emergency
/// access. Firestore's Android offline persistence queues outgoing writes.
/// Client writes can never approve a request or create an access grant.
class ParentChildChatScreen extends StatefulWidget {
  const ParentChildChatScreen({
    super.key,
    required this.childProfileId,
    required this.isParent,
  });

  final String childProfileId;
  final bool isParent;

  @override
  State<ParentChildChatScreen> createState() => _ParentChildChatScreenState();
}

class _ParentChildChatScreenState extends State<ParentChildChatScreen> {
  final TextEditingController _message = TextEditingController();
  bool _sendingMessage = false;
  bool _sendingRequest = false;
  final Set<String> _locallyRequestedPackages = <String>{};
  String? _decidingRequest;

  DocumentReference<Map<String, dynamic>> get _profile => FirebaseFirestore
      .instance.collection('child_profiles').doc(widget.childProfileId);

  @override
  void dispose() {
    _message.dispose();
    super.dispose();
  }

  void _showError(Object error) {
    if (!mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text(error.toString().replaceFirst('Exception: ', ''))),
    );
  }

  void _sendText(String uid) {
    final text = _message.text.trim();
    if (_sendingMessage || text.isEmpty || text.length > 2000) return;
    setState(() => _sendingMessage = true);
    _message.clear();
    final doc = _profile.collection('chat_messages').doc();
    // An offline Future may not complete until reconnect. Do not wait before
    // returning the UI to normal; snapshots show the queued message locally.
    unawaited(doc.set({
      'senderId': uid,
      'body': text,
      'createdAt': FieldValue.serverTimestamp(),
      'notificationState': 'pending',
    }).catchError((Object error) {
      _showError(error);
    }));
    setState(() => _sendingMessage = false);
  }

  Future<void> _requestAccess(
    String uid,
    List<Map<String, String>> apps,
    Set<String> alreadyPending,
  ) async {
    if (_sendingRequest) return;
    if (apps.isEmpty) {
      _showError('Your parent has not restricted any applications.');
      return;
    }
    String selected = apps.first['packageName']!;
    int minutes = 30;
    final submitted = await showDialog<Map<String, Object>>(
      context: context,
      builder: (dialogContext) => StatefulBuilder(
        builder: (dialogContext, setModalState) => AlertDialog(
          title: const Text('Request App Access'),
          content: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const Text('Select a restricted application:'),
              const SizedBox(height: 12),
              DropdownButtonFormField<String>(
                key: ValueKey(selected),
                initialValue: selected,
                isExpanded: true,
                items: apps.map((app) => DropdownMenuItem(
                  value: app['packageName'],
                  child: Text(app['appName']!, overflow: TextOverflow.ellipsis),
                )).toList(),
                onChanged: (value) {
                  if (value != null) setModalState(() => selected = value);
                },
              ),
              const SizedBox(height: 16),
              const Text('Requested access time:'),
              const SizedBox(height: 10),
              DropdownButtonFormField<int>(
                initialValue: minutes,
                items: const [5, 10, 15, 30, 45, 60, 90, 120]
                    .map((value) => DropdownMenuItem(
                          value: value,
                          child: Text('$value minutes'),
                        ))
                    .toList(),
                onChanged: (value) {
                  if (value != null) setModalState(() => minutes = value);
                },
              ),
              if (alreadyPending.contains(selected)) ...[
                const SizedBox(height: 12),
                const Text('You already have an unresolved request for this app.',
                    style: TextStyle(color: AppColors.danger)),
              ],
            ],
          ),
          actions: [
            TextButton(onPressed: () => Navigator.pop(dialogContext),
                child: const Text('Cancel')),
            FilledButton(
              onPressed: alreadyPending.contains(selected)
                  ? null
                  : () => Navigator.pop(dialogContext,
                      {'packageName': selected, 'minutes': minutes}),
              child: const Text('Send Request'),
            ),
          ],
        ),
      ),
    );
    if (submitted == null || !mounted) return;
    final pkg = submitted['packageName']! as String;
    if (alreadyPending.contains(pkg) || !_locallyRequestedPackages.add(pkg)) return;
    final matching = apps.firstWhere((app) => app['packageName'] == pkg);
    setState(() => _sendingRequest = true);
    final doc = _profile.collection('access_requests').doc();
    // Stable generated document ID ensures retries of this write don't create
    // a second request. The pending request appears from Firestore cache.
    unawaited(doc.set({
      'childUid': uid,
      'packageName': pkg,
      'appName': matching['appName'],
      'requestedMinutes': submitted['minutes'],
      'status': 'pending',
      'createdAt': FieldValue.serverTimestamp(),
      'notificationState': 'pending',
    }).catchError((Object error) {
      _locallyRequestedPackages.remove(pkg);
      _showError(error);
    }));
    setState(() => _sendingRequest = false);
  }

  Future<void> _decide(
    String requestId, {
    required bool approve,
    required int minutes,
  }) async {
    if (_decidingRequest != null) return;
    setState(() => _decidingRequest = requestId);
    try {
      final user = FirebaseAuth.instance.currentUser;
      if (user == null) throw StateError('Sign in again.');
      final token = await user.getIdToken();
      await Dio().post<Object?>(
        '${AppConfig.backendBaseUrl}/chat/requests/${widget.childProfileId}/$requestId/decision',
        data: {'approve': approve, 'approvedMinutes': approve ? minutes : null},
        options: Options(headers: {'Authorization': 'Bearer $token'}),
      );
      // The Firestore server streams the authoritative status, so no local
      // client-side 'approved' write is made here.
    } catch (error) {
      _showError(error);
    } finally {
      if (mounted) setState(() => _decidingRequest = null);
    }
  }

  Future<void> _openApprovalDialog(String id, int requested) async {
    var minutes = requested;
    final decided = await showDialog<int>(
      context: context,
      builder: (dialogContext) => StatefulBuilder(
        builder: (dialogContext, setModalState) => AlertDialog(
          title: const Text('Approve Temporary Access'),
          content: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text('Requested: $requested minutes'),
              const SizedBox(height: 12),
              const Text('Approved duration (can be changed):'),
              const SizedBox(height: 8),
              DropdownButtonFormField<int>(
                initialValue: minutes,
                items: (<int>{5, 10, 15, 20, 30, 45, 60, 90, 120, 180, requested}
                      .toList()..sort())
                    .map((value) => DropdownMenuItem<int>(
                          value: value,
                          child: Text('$value minutes'),
                        ))
                    .toList(),
                onChanged: (value) {
                  if (value != null) setModalState(() => minutes = value);
                },
              ),
            ],
          ),
          actions: [
            TextButton(onPressed: () => Navigator.pop(dialogContext),
                child: const Text('Cancel')),
            FilledButton(onPressed: () => Navigator.pop(dialogContext, minutes),
                child: const Text('Approve')),
          ],
        ),
      ),
    );
    if (decided != null) {
      await _decide(id, approve: true, minutes: decided);
    }
  }

  static String _time(dynamic raw) {
    if (raw is! Timestamp) return 'Sending...';
    final date = raw.toDate();
    final h = date.hour % 12 == 0 ? 12 : date.hour % 12;
    final m = date.minute.toString().padLeft(2, '0');
    return '$h:$m ${date.hour < 12 ? 'AM' : 'PM'}';
  }

  static IconData _fallback(String name) {
    final n = name.toLowerCase();
    if (n.contains('youtube')) return Icons.play_circle_fill_rounded;
    if (n.contains('facebook') || n.contains('chrome')) return Icons.public_rounded;
    if (n.contains('game') || n.contains('legend')) return Icons.sports_esports_rounded;
    return Icons.apps_rounded;
  }

  String? _iconFor(Map<String, dynamic> profile, String pkg) {
    final report = profile['latestUsageReport'];
    if (report is! Map) return null;
    final allApps = report['allApps'];
    if (allApps is! List) return null;
    for (final entry in allApps) {
      if (entry is Map && entry['packageName'] == pkg && entry['iconBase64'] is String) {
        return entry['iconBase64'] as String;
      }
    }
    return null;
  }

  Widget _requestCard(Map<String, dynamic> request, String id,
      Map<String, dynamic> profile) {
    final app = (request['appName'] ?? request['packageName'] ?? 'App').toString();
    final pkg = (request['packageName'] ?? '').toString();
    final requested = request['requestedMinutes'] is num
        ? (request['requestedMinutes'] as num).toInt() : 0;
    final rawStatus = (request['status'] ?? 'pending').toString();
    final endTime = request['expiresAt'];
    final status = rawStatus == 'active' && endTime is Timestamp &&
            !endTime.toDate().isAfter(DateTime.now())
        ? 'expired'
        : rawStatus;
    final approved = request['approvedMinutes'];
    final pending = status == 'pending';
    return Align(
      alignment: Alignment.centerLeft,
      child: Container(
        margin: const EdgeInsets.symmetric(vertical: 7),
        constraints: const BoxConstraints(maxWidth: 340),
        padding: const EdgeInsets.all(15),
        decoration: BoxDecoration(
          color: Colors.white,
          borderRadius: BorderRadius.circular(18),
          border: Border.all(color: const Color(0xFFDDE6F6)),
        ),
        child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          const Row(children: [
            Icon(Icons.lock_clock_rounded, color: AppColors.primary),
            SizedBox(width: 8),
            Text('App Access Request', style: TextStyle(fontWeight: FontWeight.w800)),
          ]),
          const SizedBox(height: 10),
          Row(children: [
            AppUsageIcon(
              encoded: _iconFor(profile, pkg),
              fallback: _fallback(app),
              fallbackColor: AppColors.primary,
            ),
            const SizedBox(width: 10),
            Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              Text(app, style: const TextStyle(fontWeight: FontWeight.w800)),
              Text('Requested: $requested minutes'),
              Text(pkg, maxLines: 1, overflow: TextOverflow.ellipsis,
                  style: const TextStyle(color: AppColors.textSecondary, fontSize: 10)),
              if (approved is num) Text('Approved: ${approved.toInt()} minutes'),
            ])),
          ]),
          const SizedBox(height: 8),
          Text('Status: ${status.replaceAll('_', ' ')}  •  ${_time(request['createdAt'])}',
              style: const TextStyle(color: AppColors.textSecondary, fontSize: 12)),
          if (widget.isParent && pending) ...[
            const SizedBox(height: 10),
            Row(children: [
              Expanded(child: FilledButton.icon(
                onPressed: _decidingRequest == null
                    ? () => _openApprovalDialog(id, requested) : null,
                icon: const Icon(Icons.check),
                label: const Text('Approve / Edit'),
              )),
              const SizedBox(width: 8),
              IconButton.outlined(
                tooltip: 'Decline',
                onPressed: _decidingRequest == null
                    ? () => _decide(id, approve: false, minutes: 0) : null,
                icon: const Icon(Icons.close, color: AppColors.danger),
              ),
            ]),
          ],
        ]),
      ),
    );
  }

  Widget _chatBody(Map<String, dynamic> profile, String uid) {
    final parentId = (profile['parentId'] ?? '').toString();
    final childId = (profile['childAccountId'] ?? '').toString();
    if (parentId.isEmpty || childId.isEmpty) {
      return const Center(child: Text('Pair a child device to start chatting.'));
    }
    if ((widget.isParent && uid != parentId) ||
        (!widget.isParent && uid != childId)) {
      return const Center(child: Text('Only paired family members can use this chat.'));
    }
    final messages = _profile.collection('chat_messages')
        .orderBy('createdAt').limit(200).snapshots();
    final requests = _profile.collection('access_requests')
        .orderBy('createdAt').limit(100).snapshots();
    return StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
      stream: messages,
      builder: (context, messageSnapshot) {
        if (messageSnapshot.hasError) {
          return Center(child: Text('Unable to load chat: ${messageSnapshot.error}'));
        }
        return StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
          stream: requests,
          builder: (context, reqSnapshot) {
            if (reqSnapshot.hasError) {
              return Center(child: Text('Unable to load requests: ${reqSnapshot.error}'));
            }
            final reqDocs = reqSnapshot.data?.docs ?? [];
            final pending = reqDocs.where((doc) {
                final data = doc.data();
                final status = data['status'];
                if (status == 'active' && data['expiresAt'] is Timestamp &&
                    !(data['expiresAt'] as Timestamp).toDate().isAfter(DateTime.now())) {
                  return false;
                }
                return ['pending', 'approved_pending_activation', 'active'].contains(status);
              })
                .map((doc) => (doc.data()['packageName'] ?? '').toString()).toSet()
                  ..addAll(_locallyRequestedPackages);
            final timeline = <Map<String, dynamic>>[];
            for (final doc in messageSnapshot.data?.docs ?? []) {
              timeline.add({'kind': 'message', 'id': doc.id, ...doc.data()});
            }
            for (final doc in reqDocs) {
              timeline.add({'kind': 'request', 'id': doc.id, ...doc.data()});
            }
            DateTime when(Map<String, dynamic> item) {
              final raw = item['createdAt'];
              return raw is Timestamp ? raw.toDate() : DateTime.now();
            }
            timeline.sort((a, b) => when(a).compareTo(when(b)));
            return Column(children: [
              Expanded(child: timeline.isEmpty
                ? const Center(child: Text('Start a conversation with your family.'))
                : ListView.builder(
                    padding: const EdgeInsets.all(15),
                    itemCount: timeline.length,
                    itemBuilder: (context, index) {
                      final item = timeline[index];
                      if (item['kind'] == 'request') {
                        return _requestCard(item, item['id'] as String, profile);
                      }
                      final own = item['senderId'] == uid;
                      return Align(
                        alignment: own ? Alignment.centerRight : Alignment.centerLeft,
                        child: Container(
                          constraints: const BoxConstraints(maxWidth: 300),
                          margin: const EdgeInsets.symmetric(vertical: 5),
                          padding: const EdgeInsets.symmetric(horizontal: 15, vertical: 10),
                          decoration: BoxDecoration(
                            color: own ? AppColors.primary : Colors.white,
                            borderRadius: BorderRadius.circular(18),
                          ),
                          child: Column(crossAxisAlignment: CrossAxisAlignment.end, children: [
                            Text((item['body'] ?? '').toString(),
                              style: TextStyle(color: own ? Colors.white : AppColors.textPrimary)),
                            const SizedBox(height: 4),
                            Text(_time(item['createdAt']),
                              style: TextStyle(fontSize: 10,
                                color: own ? Colors.white70 : AppColors.textSecondary)),
                          ]),
                        ),
                      );
                    },
                  )),
              if (!widget.isParent)
                StreamBuilder<DocumentSnapshot<Map<String, dynamic>>>(
                  stream: FirebaseFirestore.instance.collection('app_rules')
                      .doc(parentId).snapshots(),
                  builder: (context, rulesSnapshot) {
                    final raw = rulesSnapshot.data?.data()?['rules'];
                    final apps = <Map<String, String>>[];
                    if (raw is List) {
                      for (final item in raw) {
                        if (item is Map && item['restrictEnabled'] == true &&
                            item['packageName'] is String) {
                          apps.add({
                            'packageName': item['packageName'] as String,
                            'appName': (item['appName'] ?? item['packageName']).toString(),
                          });
                        }
                      }
                    }
                    return Align(
                      alignment: Alignment.centerLeft,
                      child: TextButton.icon(
                        onPressed: _sendingRequest ? null : () =>
                            _requestAccess(uid, apps, pending),
                        icon: const Icon(Icons.lock_open_rounded),
                        label: const Text('Request app access'),
                      ),
                    );
                  },
                ),
              SafeArea(top: false, child: Padding(
                padding: const EdgeInsets.fromLTRB(10, 4, 10, 12),
                child: Row(children: [
                  Expanded(child: TextField(
                    controller: _message,
                    minLines: 1,
                    maxLines: 4,
                    maxLength: 2000,
                    decoration: InputDecoration(
                      counterText: '',
                      hintText: 'Type a message...',
                      filled: true,
                      fillColor: Colors.white,
                      border: OutlineInputBorder(borderRadius: BorderRadius.circular(28)),
                    ),
                    onSubmitted: (_) => _sendText(uid),
                  )),
                  IconButton.filled(
                    onPressed: _sendingMessage ? null : () => _sendText(uid),
                    icon: const Icon(Icons.send_rounded),
                    tooltip: 'Send message',
                  ),
                ]),
              )),
            ]);
          },
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    final uid = FirebaseAuth.instance.currentUser?.uid;
    if (uid == null || widget.childProfileId.isEmpty) {
      return const Scaffold(body: Center(child: Text('Sign in and pair a device first.')));
    }
    return Scaffold(
      backgroundColor: AppColors.background,
      appBar: AppBar(
        backgroundColor: AppColors.primary,
        foregroundColor: Colors.white,
        title: Text(widget.isParent ? 'Chat with Child' : 'Chat with Parent'),
      ),
      body: StreamBuilder<DocumentSnapshot<Map<String, dynamic>>>(
        stream: _profile.snapshots(),
        builder: (context, snapshot) {
          if (snapshot.hasError) {
            return Center(child: Text('Chat unavailable: ${snapshot.error}'));
          }
          if (!snapshot.hasData) {
            return const Center(child: CircularProgressIndicator());
          }
          final profile = snapshot.data?.data();
          if (profile == null) {
            return const Center(child: Text('Pair your devices to start chatting.'));
          }
          return _chatBody(profile, uid);
        },
      ),
    );
  }
}
