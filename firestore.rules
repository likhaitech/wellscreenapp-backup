rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'admin';
    }

    function isParentAccount() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'parent';
    }

    function hasMatchingChildProfile(parentUid, profileId) {
      let profile = get(
        /databases/$(database)/documents/child_profiles/$(profileId)
      ).data;

      return profile.parentId == parentUid &&
        profile.get('childAccountId', '') == request.auth.uid &&
        profile.get('pairingStatus', '') == 'connected';
    }

    function isPairedChildOf(parentUid) {
      let user = get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;

      let profileId = user.get('pairedChildProfileId', '');

      return user.role == 'child' &&
        user.get('pairedParentId', '') == parentUid &&
        user.get('pairingStatus', '') == 'connected' &&
        profileId is string &&
        profileId.matches('^[^/]+$') &&
        hasMatchingChildProfile(parentUid, profileId);
    }

    // User accounts.
    match /users/{uid} {

      allow read: if isSignedIn() &&
        request.auth.uid == uid;

      allow read: if isAdmin();

      // Registration must not create an already-paired account.
      allow create: if isSignedIn() &&
        request.auth.uid == uid &&
        request.resource.data.role in ['parent', 'child'] &&
        request.resource.data.get('pairedParentId', null) == null &&
        request.resource.data.get('pairedChildProfileId', null) == null &&
        request.resource.data.get('pairingCode', null) == null &&
        request.resource.data.get('pairedAt', null) == null &&
        request.resource.data.get('pairingStatus', 'not_paired')
          in ['not_paired', null];

      // Users cannot modify their own role or pairing relationships.
      // Pairing fields are managed by the trusted FastAPI backend.
      allow update: if isSignedIn() &&
        request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny([
            'pairedParentId',
            'pairedChildProfileId',
            'pairingStatus',
            'pairingCode',
            'pairedAt'
          ]);

      allow delete: if false;

      // Durable chat notifications for this account only.
      match /notifications/{notificationId} {

        allow get, list: if isSignedIn() &&
          request.auth.uid == uid;

        allow create, delete: if false;

        allow update: if isSignedIn() &&
          request.auth.uid == uid &&
          resource.data.readAt == null &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['readAt']) &&
          request.resource.data.readAt == request.time;
      }
    }

    // Child profiles.
    match /child_profiles/{childProfileId} {

      function isOwningParent() {
        return isSignedIn() &&
          resource.data.parentId == request.auth.uid;
      }

      function isClaimedByCaller() {
        return isSignedIn() &&
          ('childAccountId' in resource.data) &&
          resource.data.childAccountId == request.auth.uid;
      }

      // Pairing identity fields cannot be modified by clients.
      function pairingIdentityUnchanged() {
        return !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny([
            'id',
            'parentId',
            'childAccountId',
            'childEmail',
            'pairingStatus',
            'connectedAt',
            'createdAt'
          ]);
      }

      // The only fields the child's own device ever writes on this
      // document (child_home_screen.dart, emergency_access_service.dart,
      // alert_notification_client.dart, ScreenTimeReportJobService.kt).
      // Anything else - parentId, guardian-set fields, a guardian's
      // emergency approval - can only be changed by the owning parent.
      function childWritesOnlyOwnFields() {
        return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'childDisplayName',
            'lastSeenAt',
            'latestUsageReport',
            'usageReportUpdatedAt',
            'smsAlertLog',
            'restrictionLog',
            'syncLog',
            'browsingLog',
            'pushAlertLog',
            'mlRiskAssessment',
            'latestLocation',
            'locationUpdatedAt',
            'limitSyncAcknowledgedAt',
            'limitSyncAcknowledgedBy',
            'accessibilityEnabled',
            'accessibilityCheckedAt',
            'emergencyAccess'
          ]);
      }

      // A child may ASK for emergency access but never approve it: any
      // child write to emergencyAccess must leave it as a pending request
      // with no grantedUntil. Approval is a guardian-only write.
      function childEmergencyWriteIsRequestOnly() {
        return !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['emergencyAccess']) ||
          (
            request.resource.data.emergencyAccess is map &&
            request.resource.data.emergencyAccess.get('status', '') ==
              'requested' &&
            request.resource.data.emergencyAccess.get('grantedUntil', null) ==
              null
          );
      }

      allow read: if isOwningParent() ||
        isClaimedByCaller();

      // Child profiles must be created by the secure pairing backend.
      allow create: if false;

      // Existing family members may update permitted profile information.
      allow update: if pairingIdentityUnchanged() &&
        (
          isOwningParent() ||
          (
            isClaimedByCaller() &&
            childWritesOnlyOwnFields() &&
            childEmergencyWriteIsRequestOnly()
          )
        );

      allow delete: if false;

      match /monitoring_alerts/{alertId} {

        // Only the owning parent can view security alerts.
        allow get, list: if request.auth != null &&
          get(
            /databases/$(database)/documents/child_profiles/$(childProfileId)
          ).data.parentId == request.auth.uid;

        // Monitoring alerts are written by the trusted backend.
        allow create, update, delete: if false;
      }

      // Per-app daily limits.
      match /app_time_limits/{appPackage} {

        function childProfile() {
          return get(
            /databases/$(database)/documents/child_profiles/$(childProfileId)
          );
        }

        function isOwningLimitParent() {
          return isSignedIn() &&
            childProfile().data.parentId == request.auth.uid;
        }

        function isPairedLimitChild() {
          return isSignedIn() &&
            ('childAccountId' in childProfile().data) &&
            childProfile().data.childAccountId == request.auth.uid;
        }

        function isValidLimit() {
          return request.resource.data.keys().hasOnly([
              'packageName',
              'appName',
              'limitMinutes',
              'updatedAt'
            ]) &&
            request.resource.data.keys().hasAll([
              'packageName',
              'appName',
              'limitMinutes',
              'updatedAt'
            ]) &&
            request.resource.data.packageName == appPackage &&
            request.resource.data.appName is string &&
            request.resource.data.appName.size() > 0 &&
            request.resource.data.appName.size() <= 150 &&
            request.resource.data.limitMinutes is int &&
            request.resource.data.limitMinutes >= 1 &&
            request.resource.data.limitMinutes <= 1440 &&
            request.resource.data.updatedAt == request.time;
        }

        // Parents configure limits; paired children receive them.
        allow get, list: if isOwningLimitParent() ||
          isPairedLimitChild();

        allow create, update: if isOwningLimitParent() &&
          isValidLimit();

        allow delete: if isOwningLimitParent();
      }

      // Parent-child chat authorization.
      function chatProfile() {
        return get(
          /databases/$(database)/documents/child_profiles/$(childProfileId)
        ).data;
      }

      function chatParent() {
        return request.auth != null &&
          chatProfile().parentId == request.auth.uid;
      }

      function chatChild() {
        return request.auth != null &&
          ('childAccountId' in chatProfile()) &&
          chatProfile().childAccountId == request.auth.uid;
      }

      function chatMember() {
        return chatParent() || chatChild();
      }

      match /chat_messages/{messageId} {

        allow get, list: if chatMember();

        allow create: if chatMember() &&
          request.resource.data.keys().hasOnly([
            'senderId',
            'body',
            'createdAt',
            'notificationState'
          ]) &&
          request.resource.data.keys().hasAll([
            'senderId',
            'body',
            'createdAt',
            'notificationState'
          ]) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.body is string &&
          request.resource.data.body.size() >= 1 &&
          request.resource.data.body.size() <= 2000 &&
          request.resource.data.notificationState == 'pending' &&
          request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }

      // App access requests.
      // Writes must go through FastAPI.
      match /access_requests/{requestId} {

        allow get, list: if chatMember();

        allow create, update, delete: if false;
      }

      // Temporary application access grants.
      match /temporary_access_grants/{packageName} {

        allow get, list: if chatMember();

        allow create, update, delete: if false;
      }
    }

    // Secure pairing codes.
    // Only the trusted backend may generate or redeem codes.
    match /pairing_codes/{code} {
      allow read, write: if false;
    }

    // Server-side pairing attempt rate limits.
    match /pairing_attempt_limits/{uid} {
      allow read, write: if false;
    }

    // Application rules.
    // Only the owning parent and verified paired children can read.
    match /app_rules/{parentId} {

      allow get: if isSignedIn() &&
        (
          (request.auth.uid == parentId && isParentAccount()) ||
          isPairedChildOf(parentId)
        );

      allow list: if false;

      allow write: if isSignedIn() &&
        request.auth.uid == parentId &&
        isParentAccount();
    }

    // Restriction settings.
    match /restriction_settings/{docId} {

      allow get: if isSignedIn() &&
        (
          (
            request.auth.uid == resource.data.parentId &&
            isParentAccount()
          ) ||
          isPairedChildOf(resource.data.parentId)
        );

      allow list: if false;

      allow create: if isSignedIn() &&
        isParentAccount() &&
        request.resource.data.parentId == request.auth.uid;

      allow update, delete: if false;
    }

    // Administrative system logs.
    match /system_logs/{logId} {

      allow read: if isAdmin();

      allow write: if false;
    }

    // Deny all other paths by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}